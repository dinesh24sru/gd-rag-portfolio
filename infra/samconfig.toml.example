# Version: 0.1
# Copy to samconfig.toml and fill values. Do not commit secrets.

[default.deploy.parameters]
stack_name = "gd-rag-cognito"
resolve_s3 = true
capabilities = "CAPABILITY_IAM"
confirm_changeset = true
