# Public Cognito config for the Next.js app (no secrets).
# Copy to .env.local after `sam deploy` and fill from Cognito SAM stack outputs.

NEXT_PUBLIC_COGNITO_REGION=us-east-1
NEXT_PUBLIC_COGNITO_USER_POOL_ID=
NEXT_PUBLIC_COGNITO_CLIENT_ID=
# Host only, e.g. gd-rag-yourname.auth.us-east-1.amazoncognito.com
NEXT_PUBLIC_COGNITO_DOMAIN=
NEXT_PUBLIC_APP_URL=http://localhost:3000
# HTTP API base URL from stack output ApiBaseUrl (no trailing slash)
NEXT_PUBLIC_API_BASE_URL=
